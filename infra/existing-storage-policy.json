{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExistingCivicCanaryTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan",
        "dynamodb:TransactWriteItems"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:YOUR_ACCOUNT_ID:table/CivicCanarySites",
        "arn:aws:dynamodb:us-east-1:YOUR_ACCOUNT_ID:table/CivicCanaryFindings",
        "arn:aws:dynamodb:us-east-1:YOUR_ACCOUNT_ID:table/CivicCanaryReviews"
      ]
    },
    {
      "Sid": "ListEvidenceQueuesAndIndexes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::civic-canary"
    },
    {
      "Sid": "ExistingCivicCanaryObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::civic-canary/runs/*",
        "arn:aws:s3:::civic-canary/baselines/*",
        "arn:aws:s3:::civic-canary/snapshots/*",
        "arn:aws:s3:::civic-canary/screenshots/*",
        "arn:aws:s3:::civic-canary/playbooks/*",
        "arn:aws:s3:::civic-canary/approved/*",
        "arn:aws:s3:::civic-canary/jobs/*",
        "arn:aws:s3:::civic-canary/recent-runs/*",
        "arn:aws:s3:::civic-canary/outbox/*",
        "arn:aws:s3:::civic-canary/notification-events/*",
        "arn:aws:s3:::civic-canary/notification-claims/*"
      ]
    },
    {
      "Sid": "RemoveProcessedQueueEntries",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::civic-canary/jobs/*",
        "arn:aws:s3:::civic-canary/outbox/*"
      ]
    },
    {
      "Sid": "RemoveDeletedTargetArtifacts",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::civic-canary/runs/*",
        "arn:aws:s3:::civic-canary/baselines/*",
        "arn:aws:s3:::civic-canary/snapshots/*",
        "arn:aws:s3:::civic-canary/screenshots/*",
        "arn:aws:s3:::civic-canary/approved/*",
        "arn:aws:s3:::civic-canary/recent-runs/*",
        "arn:aws:s3:::civic-canary/notification-events/*",
        "arn:aws:s3:::civic-canary/notification-claims/*",
        "arn:aws:s3:::civic-canary/playbooks/*"
      ]
    }
  ]
}
