{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExistingCivicCanaryTables",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:Scan"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:YOUR_ACCOUNT_ID:table/CivicCanarySites",
        "arn:aws:dynamodb:us-east-1:YOUR_ACCOUNT_ID:table/CivicCanaryFindings",
        "arn:aws:dynamodb:us-east-1:YOUR_ACCOUNT_ID:table/CivicCanaryReviews"
      ]
    },
    {
      "Sid": "ListRunHistory",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::civic-canary",
      "Condition": {"StringLike": {"s3:prefix": ["runs/*"]}}
    },
    {
      "Sid": "ExistingCivicCanaryObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::civic-canary/runs/*",
        "arn:aws:s3:::civic-canary/baselines/*",
        "arn:aws:s3:::civic-canary/snapshots/*",
        "arn:aws:s3:::civic-canary/screenshots/*",
        "arn:aws:s3:::civic-canary/playbooks/*",
        "arn:aws:s3:::civic-canary/approved/*"
      ]
    }
  ]
}
