AWS_REGION=us-east-1

# Browser mode: local or agentcore
BROWSER_MODE=local

# Required when BROWSER_MODE=agentcore
AGENTCORE_BROWSER_ID=

# Amazon Bedrock model/inference profile ID
BEDROCK_MODEL_ID=

# Existing AWS resources (set CIVIC_CANARY_MODE=aws to use these)
CIVIC_CANARY_S3_BUCKET=civic-canary
CIVIC_CANARY_SITES_TABLE=CivicCanarySites
CIVIC_CANARY_FINDINGS_TABLE=CivicCanaryFindings
CIVIC_CANARY_REVIEWS_TABLE=CivicCanaryReviews

# Local and service configuration
CIVIC_CANARY_MODE=local
REVIEW_TOKEN=change-me-before-deploying
REVIEW_TOKEN_SHA256=
ALLOWED_REAL_HOSTS=
AGENT_RUNTIME_ARN=
CIVIC_CANARY_DATA_DIR=./data
# For existing tables/bucket, set CIVIC_CANARY_MODE=aws and AWS_STORAGE_LAYOUT=existing.
AWS_STORAGE_LAYOUT=
SITES_TABLE=CivicCanarySites
FINDINGS_TABLE=CivicCanaryFindings
REVIEWS_TABLE=CivicCanaryReviews
EVIDENCE_BUCKET=civic-canary
